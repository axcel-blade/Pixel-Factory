---
const images = ["/Uga.jpg", "/JHStudio.jpg", "/ASA.png", "/Athukorala.jpg"];
const slider = [...images, ...images];
---

<div class="w-full overflow-hidden rounded-xl bg-white">
  <div class="flex w-max animate-scroll gap-6">
    {
      slider.map((src) => (
        <img
          src={src}
          width={150}
          height={150}
          alt=""
          class="h-[120px] w-[120px] shrink-0 rounded-xl object-cover sm:h-[140px] sm:w-[140px] lg:h-[150px] lg:w-[150px]"
          loading="lazy"
        />
      ))
    }
  </div>
</div>
