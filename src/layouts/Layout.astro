---
import JsonLd from "@/src/components/JsonLd.astro";
import { pageMeta } from "@/lib/metadata";
import { siteConfig } from "@/lib/site";
import "@/src/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = pageMeta.title, description = pageMeta.description } = Astro.props;
const googleVerification = pageMeta.googleSiteVerification;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={pageMeta.keywords} />
    <meta name="author" content={siteConfig.name} />
    <meta name="creator" content={siteConfig.name} />
    <meta name="publisher" content={siteConfig.name} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={pageMeta.canonical} />
    <link rel="icon" href="/PixelFactoryLogo.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/PixelFactoryLogo.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:type" content={pageMeta.og.type} />
    <meta property="og:locale" content={pageMeta.og.locale} />
    <meta property="og:url" content={pageMeta.og.url} />
    <meta property="og:site_name" content={pageMeta.og.siteName} />
    <meta property="og:title" content={pageMeta.og.title} />
    <meta property="og:description" content={pageMeta.og.description} />
    <meta property="og:image" content={pageMeta.og.image} />
    <meta property="og:image:alt" content={pageMeta.og.imageAlt} />
    <meta name="twitter:card" content={pageMeta.twitter.card} />
    <meta name="twitter:title" content={pageMeta.twitter.title} />
    <meta name="twitter:description" content={pageMeta.twitter.description} />
    <meta name="twitter:image" content={pageMeta.twitter.image} />
    <meta name="robots" content="index, follow" />
    {
      googleVerification && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }
    <title>{title}</title>
    <JsonLd />
  </head>
  <body class="font-poppins antialiased">
    <slot />
  </body>
</html>
